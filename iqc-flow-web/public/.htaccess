# Panel IQC Flow en hosting compartido (Apache). Los datos están en la API (api.iqcperu.com), con inicio de sesión
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "same-origin"
  Header always set X-Robots-Tag "noindex, nofollow"
  # index.html siempre fresco para que cada despliegue se vea al instante; los assets llevan huella en el nombre
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
