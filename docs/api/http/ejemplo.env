# Copia este archivo como .env en esta misma carpeta (git ignora .env) y completa tus datos.
# Sin comillas. Evita los caracteres & y + en las contraseñas que uses aquí: el inicio de sesión
# se envía como formulario y esos caracteres se interpretarían como separadores.
IQC_CORREO=tu.correo@iqcperu.com
IQC_CONTRASENA=tu-contrasena-actual
IQC_CONTRASENA_NUEVA=tu-nueva-contrasena-definitiva
